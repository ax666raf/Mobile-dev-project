mahsoul_dz/**/*.db-wal
mahsoul_dz/**/*.db.sqbpro
mahsoul_dz/**/*.sqlite
mahsoul_dz/**/*.sqlite3

# ============================================
# Flutter App - Build and dependencies
# ============================================
mahsoul_dz/.dart_tool/
mahsoul_dz/.flutter-plugins
mahsoul_dz/.flutter-plugins-dependencies
mahsoul_dz/.packages
mahsoul_dz/.pub-cache/
mahsoul_dz/.pub/
mahsoul_dz/build/
mahsoul_dz/**/build/
mahsoul_dz/*.iml

