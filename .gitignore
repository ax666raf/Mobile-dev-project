# Flutter App - Android
# ============================================
mahsoul_dz/android/local.properties
mahsoul_dz/android/**/local.properties
mahsoul_dz/**/*.apk
mahsoul_dz/**/*.aab
mahsoul_dz/android/app/debug/
mahsoul_dz/android/app/profile/
mahsoul_dz/android/app/release/

# ============================================
# Flutter App - iOS
# ============================================
mahsoul_dz/ios/**/*.pbxuser
mahsoul_dz/ios/**/*.mode1v3
mahsoul_dz/ios/**/*.mode2v3
mahsoul_dz/ios/**/*.mode3v3
