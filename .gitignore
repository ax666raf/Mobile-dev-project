# Root level ignores
.DS_Store
.vscode/
.idea/
*.log

# ============================================
# Environment files (all subdirectories)
# ============================================
.env
.env.local
.env.*.local
*.env
**/.env
**/.env.local
**/.env.*.local
**/*.env

# ============================================
# Backend - Database files
# ============================================
mahsoul_backend/instance/
mahsoul_backend/*.db
mahsoul_backend/*.db-shm
mahsoul_backend/*.db-wal
mahsoul_backend/*.db.sqbpro
mahsoul_backend/*.sqlite
mahsoul_backend/*.sqlite3

# ============================================
# Backend - Python
# ============================================
mahsoul_backend/__pycache__/
mahsoul_backend/**/__pycache__/
mahsoul_backend/*.py[cod]
mahsoul_backend/*$py.class
mahsoul_backend/*.so
mahsoul_backend/.Python
mahsoul_backend/*.egg-info/
mahsoul_backend/dist/
mahsoul_backend/build/

# ============================================
# Backend - Virtual environments
# ============================================
mahsoul_backend/venv/
mahsoul_backend/env/
mahsoul_backend/ENV/
mahsoul_backend/.venv/
mahsoul_backend/virtualenv/

